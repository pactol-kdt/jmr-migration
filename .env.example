APP_NAME="JMR Migration"
APP_DEBUG=true
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manhour_importer
DB_USERNAME=root
DB_PASSWORD=

# Employee directory used by bin/sync-kdt.php. Same server as the app database.
DB_KDT_DATABASE=kdtphdb

VITE_APP_NAME="${APP_NAME}"

# Sidebar shortcut to another website. Leave the URL blank to hide the button.
EXTERNAL_SITE_URL=
EXTERNAL_SITE_LABEL="External site"
